rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Apps (public read of published only; writes via Admin SDK / admin panel) ──
    match /apps/{appId} {
      // Anyone can read published apps
      allow read: if resource.data.isPublished == true;

      // Only allow incrementing downloadCount from clients
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount', 'updatedAt'])
        && request.resource.data.downloadCount == resource.data.downloadCount + 1;

      // Create / delete / full update: denied for clients (use Admin SDK or fixed admin rules)
      allow create, delete: if false;
    }

    // ── Users ──
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']);
      allow delete: if false;

      match /favorites/{appId} {
        allow read, write: if isOwner(uid);
      }

      match /history/{appId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Reviews ──
    match /apps/{appId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'rating', 'createdAt']);
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
